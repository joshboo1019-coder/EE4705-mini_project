# Copy to .env (git-ignored) and fill in only the provider you use:
#   cp .env.example .env
# A key exported in your shell overrides .env. Offline tests need no key.
# Alibaba Model Studio, international region (Qwen; default LLM_SERVICE / VLM_SERVICE)
DASHSCOPE_API_KEY=your-key-here
# Gemini
GOOGLE_API_KEY=your-key-here
# OpenAI
OPENAI_API_KEY=your-key-here
